    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": ["watchtogether", "hls", "webrtc", "screenshare", "voicechat"],
  "author": "ratman4080",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  }
}
