{
  "name": "synchro-watchtogether",
  "version": "1.0.0",
  "description": "Ultra Low-Latency Watch Party with HLS, Sports Streams, Screen Share & Voice Chat",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
